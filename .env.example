# Copy to .env and fill in. Never commit .env.

# Paperclip (same VPS, loopback, local_trusted mode: no token needed)
PAPERCLIP_API_URL=http://127.0.0.1:3100/api
PAPERCLIP_COMPANY_ID=5f4ec456-72c7-4cc6-961c-0549c47660f4

# Panel login (single user for now)
PANEL_EMAIL=
PANEL_PASSWORD=
SESSION_SECRET=
PAPERCLIP_MOCK=1

# Panel server
HOST=127.0.0.1
PORT=3400

# Chat sessions (brief 02). Optional.
# Wake the agent after creating a session issue: create (default) | every (also after each message) | off
PANEL_CHAT_WAKEUP=create
# How long a new session waits for a first reply (no live run) before falling back to the single /chats chat
PANEL_SESSION_REPLY_TIMEOUT_MS=180000
# Mock only: test the fallback. 1 or create = session create fails; noreply = sessions never get a reply
PAPERCLIP_MOCK_SESSIONS_FAIL=
